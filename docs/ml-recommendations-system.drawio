                <mxCell id="ml-user-based-title" value="USER-BASED (Collaborative Filtering)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#880e4f;" parent="ml-1" vertex="1">
