                    <mxGeometry x="390" y="385" width="330" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="ml-item-based-formula" value="similarity = cosine(item_factors[i], item_factors[j])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#ec407a;fontSize=11;fontFamily=Courier New;" parent="ml-1" vertex="1">
                    <mxGeometry x="400" y="410" width="310" height="30" as="geometry"/>
