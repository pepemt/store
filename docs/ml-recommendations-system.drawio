                </mxCell>
                <mxCell id="ml-user-based-formula" value="score = user_factors[u] @ item_factors.T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#ec407a;fontSize=11;fontFamily=Courier New;" parent="ml-1" vertex="1">
                    <mxGeometry x="70" y="410" width="290" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ml-user-based-process" value="1. Obtener user_factors[user_idx]&lt;br&gt;2. Producto punto con todos item_factors&lt;br&gt;3. Filtrar items ya comprados&lt;br&gt;4. Ordenar por score descendente&lt;br&gt;5. Retornar top-N" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#880e4f;" parent="ml-1" vertex="1">
