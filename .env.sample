# OCI Generative AI Configuration
# Generated from: terraform output genai_configuration_summary
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_COMPARTMENT_ID=ocid1.tenancy.oc1...
OCI_GENAI_MODEL_ID=meta.llama-3.3-70b-instruct

# PostgreSQL (store database)
STORE_DATABASE_USER=username
STORE_DATABASE_PASSWORD=password
STORE_DATABASE_NAME=store
STORE_DATABASE_HOST=localhost
STORE_DATABASE_PORT=5432
STORE_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/store

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=3000
FASTAPI_DEBUG=true

# MLflow PostgreSQL Backend (mlflow database)
MLFLOW_DATABASE_USER=username
MLFLOW_DATABASE_PASSWORD=password
MLFLOW_DATABASE_NAME=mlflow
MLFLOW_DATABASE_HOST=localhost
MLFLOW_DATABASE_PORT=5432
MLFLOW_BACKEND_STORE_URI=postgresql://username:password@localhost:5432/mlflow

# OCI Object Storage (S3-Compatible) for MLflow artifacts
# Generated by Terraform - see: terraform output s3_credentials_summary
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-chicago-1
MLFLOW_S3_ENDPOINT_URL=https://xxxxxxx.compat.objectstorage.us-chicago-1.oraclecloud.com
MLFLOW_S3_BUCKET=mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow/

# MLflow Server Configuration
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=store-experiments
MLFLOW_REGISTRY_URI=

# Spark Configuration
SPARK_MASTER_HOST=0.0.0.0
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=8g
SPARK_WORKER_WEBUI_PORT=8081
SPARK_NO_DAEMONIZE=true

# Spark Application Settings
SPARK_APP_NAME=MySparkApp
SPARK_MASTER_URL=local[*]
SPARK_DATABASE_URL=jdbc:postgresql://localhost:5432/store?sslmode=disable
SPARK_DATABASE_USER=username
SPARK_DATABASE_PASSWORD=password

# Oracle Autonomous Database (for Vector Search)
ORACLE_USER=username
ORACLE_PASSWORD=password
ORACLE_DSN=storedb_high
ORACLE_WALLET_LOCATION=.data/adb-wallet
ORACLE_WALLET_PASSWORD=your_wallet_password
