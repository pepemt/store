# OCI Generative AI Configuration
# Generated from: terraform output genai_configuration_summary
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_COMPARTMENT_ID=ocid1.tenancy.oc1...
OCI_GENAI_MODEL_ID=xai.grok-4-fast-non-reasoning
OCI_GENAI_VISION_MODEL_ID=meta.llama-3.2-90b-vision-instruct

# PostgreSQL (store database)
STORE_DATABASE_USER=username
STORE_DATABASE_PASSWORD=password
STORE_DATABASE_NAME=store
STORE_DATABASE_HOST=localhost
STORE_DATABASE_PORT=5432
STORE_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/store

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=3000
FASTAPI_DEBUG=true

# OCI Object Storage (S3-Compatible) for Store application
# Generated by Terraform - see: terraform output s3_credentials_summary
STORE_S3_ACCESS_KEY_ID=your_access_key
STORE_S3_SECRET_ACCESS_KEY=your_secret_key
STORE_S3_REGION=us-chicago-1
STORE_S3_ENDPOINT_URL=https://xxxxxxx.compat.objectstorage.us-chicago-1.oraclecloud.com
STORE_S3_BUCKET=store

# MLflow PostgreSQL Backend (mlflow database)
MLFLOW_DATABASE_USER=username
MLFLOW_DATABASE_PASSWORD=password
MLFLOW_DATABASE_NAME=mlflow
MLFLOW_DATABASE_HOST=localhost
MLFLOW_DATABASE_PORT=5432
MLFLOW_BACKEND_STORE_URI=postgresql://username:password@localhost:5432/mlflow

# MinIO Configuration (S3-Compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=mlflow

# MLflow S3 Configuration (using MinIO)
MLFLOW_S3_ACCESS_KEY_ID=minioadmin
MLFLOW_S3_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_S3_BUCKET=mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow/

# MLflow Server Configuration
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=store-experiments
MLFLOW_REGISTRY_URI=

# Spark Configuration
SPARK_MASTER_HOST=0.0.0.0
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=8g
SPARK_WORKER_WEBUI_PORT=8081
SPARK_NO_DAEMONIZE=true

# Spark Application Settings
SPARK_APP_NAME=MySparkApp
SPARK_MASTER_URL=local[*]
SPARK_DATABASE_URL=jdbc:postgresql://localhost:5432/store?sslmode=disable
SPARK_DATABASE_USER=username
SPARK_DATABASE_PASSWORD=password

# Oracle Autonomous Database (for Vector Search)
ORACLE_USER=username
ORACLE_PASSWORD=password
ORACLE_DSN=storedb_high
ORACLE_WALLET_LOCATION=.data/adb-wallet
ORACLE_WALLET_PASSWORD=your_wallet_password

MLFLOW_MODEL_URI=runs:/34a37s.../model

# OCI SDK Configuration (for API authentication)
# These are used to generate /root/.oci/config at runtime
# The private.pem file should be mounted as a volume at runtime
OCI_USER=ocid1.user.oc1..your_user_ocid
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_TENANCY=ocid1.tenancy.oc1..your_tenancy_ocid
OCI_REGION=us-chicago-1
OCI_KEY_FILE=/root/.oci/private.pem

# AUDIO / TRANSCRIPCIÓN
UPLOAD_MAX_MB=25
FFMPEG_PATH=C:\ffmpeg\ffmpeg-8.0.1-essentials_build\bin\ffmpeg.exe
STT_MODEL_NAME=medium
STT_DEFAULT_LANG=es

# Backend STT (por túnel SSH local)
TRANSCRIBE_BACKEND_URL=http://100.79.20.59:19000/transcribe
ORACLE_STT_URL=http://100.79.20.59:19000/transcribe
ORACLE_STT_TIMEOUT_MS=60000